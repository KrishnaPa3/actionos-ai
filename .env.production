# =============================================================================
# ActionOS — Production Environment Template
# =============================================================================
# For production deployment, set these as environment variables on your
# hosting platform (e.g., Railway, Render, Fly.io, AWS, GCP, Azure).
#
# If your platform supports .env files, copy this template:
#   cp .env.production .env
#
# IMPORTANT: Replace all placeholder URLs with your actual production domains.
# =============================================================================

# === Supabase (REQUIRED) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === AI Provider ===
# For production, you may want a cloud provider instead of Ollama
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
# Or keep Ollama if self-hosting:
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434/v1
# OLLAMA_MODEL=qwen3:8b

# === HuggingFace ===
HF_TOKEN=hf_your_huggingface_token

# === Notion (optional) ===
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://api.yourdomain.com/oauth/notion/callback

# === Google Calendar (optional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/oauth/google/callback

# === Slack (optional) ===
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://api.yourdomain.com/oauth/slack/callback

# === Production URLs ===
# Replace with your actual production domains
FRONTEND_URL=https://app.yourdomain.com
BACKEND_URL=https://api.yourdomain.com
CORS_ORIGINS=https://app.yourdomain.com

# === Frontend Vite (build-time) ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=https://api.yourdomain.com
VITE_SITE_URL=https://app.yourdomain.com

# === Production hardening ===
MAX_UPLOAD_SIZE=20971520
UPLOAD_RATE_LIMIT=20/minute
AUTH_RATE_LIMIT=30/minute
OAUTH_RATE_LIMIT=20/minute
LOG_LEVEL=INFO

# === Debug ===
DEBUG_TIMING=0