# =============================================================================
# ActionOS — Local Development Environment Template
# =============================================================================
# Copy to .env and fill in values for LOCAL development (npm run dev + uvicorn)
#
# Backend:  copy backend/.env.example to backend/.env
# Frontend: copy frontend/.env.example to frontend/.env
#
# This file documents the local development defaults.
# The actual local config lives in backend/.env and frontend/.env.
# =============================================================================

# Backend (backend/.env)
# ----------------------
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:5173
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AI_PROVIDER=ollama
# OLLAMA_MODEL=qwen3:8b
# DEBUG_TIMING=1

# Frontend (frontend/.env)
# ------------------------
# VITE_API_URL=http://localhost:8000
# VITE_SITE_URL=http://localhost:5173
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# OAuth Redirect URIs (local)
# ---------------------------
# NOTION_REDIRECT_URI=http://localhost:8000/oauth/notion/callback
# GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback
# SLACK_REDIRECT_URI=http://localhost:8000/oauth/slack/callback