# =============================================================================
# ActionOS Environment Variables — Template
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# This root .env is used by Docker Compose for variable interpolation.
# For LOCAL development (without Docker), use:
#   backend/.env   — backend runtime config (loaded by python-dotenv)
#   frontend/.env  — Vite build-time config
#
# Required variables are marked with (REQUIRED)
# Optional variables have sensible defaults (shown in comments)
# =============================================================================

# ============================================================================
# Supabase (REQUIRED)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# AI Provider
# ============================================================================
# Options: ollama (default), openai, gemini, anthropic
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL is set automatically in docker-compose.yml

# For cloud AI providers (optional - only if AI_PROVIDER != ollama)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4

# ============================================================================
# HuggingFace (REQUIRED for WhisperX diarization)
# ============================================================================
HF_TOKEN=hf_your_huggingface_token

# ============================================================================
# Notion Integration (optional)
# ============================================================================
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# OAuth redirect URI — must match what's registered in Notion
# Local:      http://localhost:8000/oauth/notion/callback
# Docker:     http://localhost:8000/oauth/notion/callback
# Production: https://api.yourdomain.com/oauth/notion/callback
NOTION_REDIRECT_URI=http://localhost:8000/oauth/notion/callback

# ============================================================================
# Google Calendar Integration (optional)
# ============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# ============================================================================
# Slack Integration (optional)
# ============================================================================
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/oauth/slack/callback

# ============================================================================
# Frontend / API URLs
# ============================================================================
# These are the browser-accessible URLs.
# Local dev:  http://localhost:5173 / http://localhost:8000
# Docker:     http://localhost:5173 / http://localhost:8000 (with port mapping)
# Production: https://app.yourdomain.com / https://api.yourdomain.com
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# CORS origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost:5173

# ============================================================================
# Frontend (Vite) — build-time variables
# ============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:8000
VITE_SITE_URL=http://localhost:5173

# ============================================================================
# Debug / Performance
# ============================================================================
DEBUG_TIMING=0