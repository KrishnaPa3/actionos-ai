# =============================================================================
# ActionOS Backend — Environment Variables Template
# =============================================================================
# Copy to .env and fill in values for LOCAL development:
#   cp .env.example .env
#
# For Docker Compose, do NOT use this file — the root .env is used instead.
# For production, set environment variables on your hosting platform.
# =============================================================================

# === Supabase (REQUIRED) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === HuggingFace (REQUIRED for WhisperX diarization) ===
HF_TOKEN=hf_your_huggingface_token

# === Application URLs (LOCAL DEVELOPMENT) ===
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# === AI Provider ===
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# === Notion Integration (optional) ===
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/oauth/notion/callback

# === Google Calendar Integration (optional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# === Slack Integration (optional) ===
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/oauth/slack/callback

# === Debug / Performance ===
DEBUG_TIMING=1