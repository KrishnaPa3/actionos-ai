# =============================================================================
# ActionOS — Docker Compose Environment Template
# =============================================================================
# Copy to .env and fill in values for Docker Compose deployment:
#   cp .env.docker .env
#   docker compose up -d
#
# Docker Compose reads this file for ${VAR} interpolation in
# docker-compose.yml.  All Docker-specific values (service URLs,
# CORS, OAuth redirect URIs) are injected automatically.
#
# NOTE: The root .env file IS the Docker environment file.
#       This template documents the Docker-specific overrides.
# =============================================================================

# === Supabase (REQUIRED) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === AI Provider ===
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL is set in docker-compose.yml to http://ollama:11434/v1

# === HuggingFace ===
HF_TOKEN=hf_your_huggingface_token

# === Notion (optional) ===
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# For Docker with port mapping, use localhost (browser-accessible)
NOTION_REDIRECT_URI=http://localhost:8000/oauth/notion/callback

# === Google Calendar (optional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# === Slack (optional) ===
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/oauth/slack/callback

# === URLs (Docker with port mapping — browser accesses via localhost) ===
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# === Frontend Vite (build-time) ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:8000
VITE_SITE_URL=http://localhost:5173

# === Debug ===
DEBUG_TIMING=0